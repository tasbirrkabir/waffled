generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Email subscribers for "new flavour alerts" captured from the website
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Anonymous CTA click events (menu / directions / call / social) — no PII
model CtaEvent {
  id        String   @id @default(cuid())
  type      String
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

// Online orders placed through /order (confirmed via WhatsApp/call)
model Order {
  id           String   @id @default(cuid())
  orderNumber  String   @unique
  customerName String
  phone        String
  // "pickup" | "delivery"
  fulfillment  String   @default("pickup")
  // Delivery address, required when fulfillment = "delivery"
  address      String?
  // Chosen (pickup) or preferred (delivery) time slot
  pickupTime   String
  // "cash" | "bkash" | "nagad"
  paymentMethod String  @default("cash")
  // bKash/Nagad transaction id for verification, required when paymentMethod != "cash"
  trxId        String?
  notes        String?
  items        String // JSON-encoded [{id,name,price,qty}]
  total        Int
  status       String   @default("new")
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}
